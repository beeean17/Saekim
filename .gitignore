# ========================================
# Saekim - Markdown Editor
# .gitignore
# ========================================

# ============ Development ============

# Claude Code (AI assistant configuration)
.claude/
.agent/
_bmad/
claude.md
CLAUDE.md

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
env/
ENV/
.venv

# Distribution / Packaging
build/
dist/
*.egg-info/
*.egg
*.whl

# Chromium Build Files
/vendor

# Build Artifacts
*.exe
*.msi
*.app
*.dmg
*.deb
*.rpm

# Installer Output
installer/
output/
releases/

# Beta Build Files
BETA_README.md

# install packages
node_modules/
jspm_packages/
pkgroot/
*.pkg
src-tauri/target/
src-tauri/gen/


# ============ IDE & Editors ============

# VS Code
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============ OS Files ============

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ============ User Data ============

# User data directory (contains user documents, settings, cache)
# Keep directory structure but ignore user content
data/*
!data/.gitkeep
!data/temp/
data/temp/*
!data/temp/.gitkeep
!data/images/
data/images/*
!data/images/.gitkeep
tests/*

# User Session Data
.saekim/
session.json

# Exports (user-generated files)
exports/
output/

# ============ Logs ============

# Application logs
*.log
logs/
app.log
error.log
debug.log

# ============ Temporary Files ============

*.tmp
*.temp
*.bak
*.backup
~*
.~lock.*

# Font Archives (keep extracted fonts, ignore archives)
src/resources/fonts/*.zip
src/resources/fonts/*.tar.gz

# Old/Backup Files
*_OLD.*
*_BACKUP.*
private/README_OLD.md

# ============ Testing ============

# pytest
.pytest_cache/
.coverage
htmlcov/
.tox/
*.pdf
# ============ Security ============

# Environment variables
.env
.env.local
.env.*.local

# Credentials
credentials.json
secrets.json
*.key
*.pem
*.cert

# ============ Qt ============

# Qt compiled translation files
*.qm

# ========================================
# Note: Markdown files are included by default
# Only claude.md is excluded (AI instructions)
# private/ is managed as a Git submodule
# ========================================
nul
log.txt


# End of .gitignore
