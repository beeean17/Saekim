{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Saekim",
  "version": "3.1.0",
  "identifier": "com.beeean17.saekim",
  "build": {
    "beforeDevCommand": "corepack pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "corepack pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Saekim",
        "width": 1280,
        "height": 820,
        "minWidth": 622,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 13,
          "y": 19
        },
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$HOME/**/.assets/**",
          "$PICTURE/**",
          "$PICTURE/**/.assets/**",
          "$DESKTOP/**",
          "$DESKTOP/**/.assets/**",
          "$DOCUMENT/**",
          "$DOCUMENT/**/.assets/**",
          "$DOWNLOAD/**",
          "$DOWNLOAD/**/.assets/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "contentTypes": ["net.daringfireball.markdown"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "contentTypes": ["public.plain-text"],
        "name": "Text Document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ]
  }
}
