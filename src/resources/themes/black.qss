/* black Theme QSS */
/* === Saekim Design Tokens (mockup-aligned) ===
   bg-app #0D1117, bg-titlebar #161B22, bg-sidebar #0D1117, bg-tabs #161B22,
   bg-editor #0D1117, bg-statusbar #161B22
   border-subtle #21262D, border-soft #30363D, border-strong #484F58
   accent #5EEAD4, accent-soft rgba(94,234,212,12%)
   === */
QMainWindow {
    background-color: #0D1117;
    color: #C9D1D9;
}

QWidget {
    background-color: #0D1117;
    color: #C9D1D9;
    font-family: "Pretendard", "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

/* Remove focus border from all buttons */
QPushButton:focus {
    border: none;
    outline: none;
}

/* Dock Widget */
QDockWidget {
    titlebar-close-icon: url(:/icons/close.png);
    titlebar-normal-icon: url(:/icons/float.png);
    border: none;
    border-right: 1px solid #30363D; /* File Explorer Separator */
    background-color: #0D1117;
}

QDockWidget::title {
    background-color: #161B22;
    padding: 5px;
    border-radius: 4px;
    color: #C9D1D9;
    border-bottom: 1px solid #30363D;
}

QWidget#ExplorerHeader {
    background-color: #0D1117;
    border-bottom: 1px solid #21262D;
}

QLabel#ExplorerTitle {
    color: #6E7781;
    font-size: 11px;
    font-weight: 700;
}

QLabel#ExplorerPath {
    color: #8B949E;
    font-size: 11px;
}

QToolButton#ExplorerActionButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px;
}

QToolButton#ExplorerActionButton:hover {
    background-color: #21262D;
    border-color: #30363D;
}

/* Tree View (File Explorer) */
QTreeView {
    background-color: #0D1117;
    border: none;
    outline: none;
    padding: 5px;
}

QTreeView::item {
    padding: 6px;
    border-radius: 4px;
    margin: 2px 0;
    color: #C9D1D9;
}

QTreeView::item:hover {
    background-color: #161B22;
}

QTreeView::item:selected {
    background-color: #30363D; /* Dark Gray */
    color: #5EEAD4;
    border: 1px solid #5EEAD4;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #30363D;
    background-color: #0D1117;
    border-radius: 0px;
}

QTabBar::tab {
    background-color: #161B22;
    color: #8B949E;
    border: 1px solid #30363D;
    border-bottom: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    padding: 5px 16px 4px 16px;
    margin-right: 0px;
    min-width: 100px;
    font-family: "JetBrains Mono", "Pretendard";
    font-size: 12px;
}

QTabBar::tab:selected {
    background-color: #0D1117;
    color: #5EEAD4;
    border-top: 2px solid #5EEAD4;
    border-bottom: 1px solid #0D1117;
}

QTabBar::tab:hover {
    background-color: #0D1117;
    color: #C9D1D9;
}

QTabBar::close-button {
    image: @TAB_CLOSE_ICON@;
    subcontrol-position: right;
    margin: 2px;
    border-radius: 4px;
    width: 16px;
    height: 16px;
}

QTabBar::close-button:hover {
    background-color: #21262D;
    image: @TAB_CLOSE_HOVER_ICON@;
}

QTabBar::close-button:pressed {
    background-color: #30363D;
}

QTabBar::scroller {
    /* Allow scroller to size itself */
    width: 48px;
}

QTabBar QToolButton {
    background-color: #161B22;
    border: 1px solid #30363D;
    border-radius: 4px;
    margin: 1px;
    padding: 2px;
}

QTabBar QToolButton:hover {
    background-color: #21262D;
}

/* Toolbar */
QToolBar {
    background-color: #161B22;
    border-bottom: none; /* Removed bottom border */
    padding: 4px;
    spacing: 6px;
}

QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 4px;
    color: #C9D1D9;
}

QToolButton:hover {
    background-color: #21262D;
    border: 1px solid #30363D;
}

QToolButton:pressed {
    background-color: #30363D;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background-color: #0D1117;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #30363D;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #484F58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #0D1117;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #30363D;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #484F58;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Menu Bar */
QMenuBar {
    background-color: #161B22;
    color: #C9D1D9;
    border-bottom: none; /* Removed bottom border */
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #21262D;
}

QMenu {
    background-color: #161B22;
    color: #C9D1D9;
    border: 1px solid #30363D;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px 6px 10px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #30363D;
    color: #C9D1D9;
}

/* Status Bar */
QStatusBar {
    background-color: #161B22;
    color: #8B949E;
    border-top: 1px solid #30363D;
    font-family: "JetBrains Mono", "Pretendard";
    font-size: 11px;
    min-height: 26px;
}

QStatusBar QLabel {
    color: #8B949E;
    padding: 0 8px;
    border-right: 1px solid #21262D;
}

QStatusBar QLabel[separator="false"] {
    border-right: none;
}

QStatusBar QLabel#StatusFilePath {
    color: #C9D1D9;
    border-right: none;
    font-family: "Pretendard";
}

QStatusBar QLabel[role="saved"][state="saved"] {
    color: #5EEAD4;
}

QStatusBar QLabel[role="saved"][state="dirty"] {
    color: #D29922;
}

/* Title Bar Buttons */
QPushButton#TitleBarButton, QPushButton#TitleBarCloseButton {
    background-color: transparent;
    border: none;
    border-radius: 4px;
}

QPushButton#TitleBarButton:hover {
    background-color: #21262D;
}

QPushButton#TitleBarCloseButton:hover {
    background-color: #30363D;
}

/* Welcome Screen */
QWidget#WelcomeScreen {
    background-color: #0D1117;
}

QWidget#WelcomeCard {
    background-color: transparent;
    border: none;
}

QPushButton#WelcomeButtonPrimary {
    background-color: #0366d6;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#WelcomeButtonPrimary:hover {
    background-color: #0256b4;
}

QPushButton#WelcomeButtonPrimary:pressed {
    background-color: #024494;
}

/* View Toggle Buttons - Connected Group */
QWidget#ViewToggleContainer {
    background-color: transparent;
}

QPushButton#ViewToggleButton {
    background-color: #2a2a2a;
    border: 1px solid #404040;
    border-radius: 0px;
    color: #e0e0e0;
    font-size: 12px;
    font-family: "Pretendard";
    padding: 4px 8px;
}

QPushButton#ViewToggleButton[position="left"] {
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
}

QPushButton#ViewToggleButton[position="middle"] {
    border-left: none;
}

QPushButton#ViewToggleButton[position="right"] {
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left: none;
}

QPushButton#ViewToggleButton:hover {
    background-color: #3a3a3a;
    color: #ffffff;
}

QPushButton#ViewToggleButton[active="true"] {
    background-color: #5EEAD4;
    border-color: #5EEAD4;
    color: #0D1117;
    font-weight: bold;
}

QPushButton#ViewToggleButton[active="true"][position="middle"] {
    border-left: 1px solid #5EEAD4;
}

QPushButton#ViewToggleButton[active="true"][position="right"] {
    border-left: 1px solid #5EEAD4;
}

QPushButton#ViewToggleButton[active="true"]:hover {
    background-color: #d0d0d0;
    color: #000000;
}

QPushButton#ViewToggleButton:pressed {
    background-color: #505050;
}

/* === Mockup-exact shell override === */
QMainWindow, QWidget { background-color: #0F1419; color: #E6EDF3; }
QFrame#TitleBar { background-color: #0B0F14; border-bottom: 1px solid #1F2731; }
QLabel#TitleLabel { color: #9BA8B8; font-size: 12px; font-weight: 500; }
QDockWidget { background-color: #131820; border: none; border-right: 1px solid #1F2731; }
QDockWidget::title { background-color: #131820; color: #6A7787; border-bottom: 1px solid #1F2731; }
QWidget#ExplorerHeader { background-color: #131820; border-bottom: none; }
QWidget#ExplorerPathBar { background-color: #131820; border-bottom: 1px solid #1F2731; }
QWidget#ExplorerSortBar { background-color: #131820; border-bottom: 1px solid #1F2731; min-height: 28px; }
QLabel#ExplorerTitle { color: #6A7787; font-size: 11px; font-weight: 600; }
QLabel#ExplorerPath { color: #6A7787; font-size: 11px; font-family: "JetBrains Mono"; background-color: transparent; border: none; }
QTreeView { background-color: #131820; color: #9BA8B8; border: none; padding: 0px; show-decoration-selected: 0; }
QTreeView::item { padding: 6px 4px; border-radius: 6px; margin: 1px 0; color: #9BA8B8; }
QTreeView::branch, QTreeView::branch:selected, QTreeView::branch:hover { background: transparent; image: none; }
QTreeView::item:hover { background-color: rgba(255, 255, 255, 0.03); color: #E6EDF3; }
QTreeView::item:selected { background-color: rgba(94, 234, 212, 0.12); color: #E6EDF3; border: none; }
QTabWidget::pane { border: none; background-color: #0F1419; }
QTabBar { background-color: #0F1419; }
QTabBar::tab { background-color: transparent; color: #6A7787; border: none; border-top: 2px solid transparent; border-radius: 6px 6px 0 0; padding: 0 12px; margin-right: 2px; height: 32px; max-width: 200px; font-family: "JetBrains Mono", "Pretendard"; font-size: 12px; }
QTabBar::tab:hover { background-color: rgba(255, 255, 255, 0.02); color: #9BA8B8; }
QTabBar::tab:selected { background-color: #161C24; color: #E6EDF3; border-top: 2px solid #5EEAD4; border-bottom: none; }
QToolButton, QPushButton#TitleBarButton, QPushButton#TitleBarCloseButton, QToolButton#ExplorerActionButton, QToolButton#ExplorerSortButton { background-color: transparent; border: none; border-radius: 6px; color: #6A7787; }
QToolButton:hover, QPushButton#TitleBarButton:hover, QToolButton#ExplorerActionButton:hover, QToolButton#ExplorerSortButton:hover { background-color: #1F2731; color: #E6EDF3; }
QPushButton#TitleBarCloseButton:hover { background-color: #2D3744; }
QStatusBar { background-color: #0B0F14; color: #6A7787; border-top: 1px solid #1F2731; font-family: "JetBrains Mono", "Pretendard"; font-size: 11px; min-height: 26px; }
QStatusBar QLabel { color: #6A7787; padding: 0 8px; border-right: 1px solid #2D3744; }
QStatusBar QLabel#StatusFilePath { color: #9BA8B8; border-right: none; font-family: "Pretendard"; }
QStatusBar QLabel[separator="false"] { border-right: none; }
QStatusBar QLabel[role="saved"][state="saved"] { color: #5EEAD4; }
QStatusBar QLabel[role="saved"][state="dirty"] { color: #FBBF24; }
